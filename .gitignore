# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-verify/
/.next-verify-tmp/
/.next-e2e/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
# .env.test SÍ se commitea a propósito (ver el comentario dentro del
# archivo) — son credenciales de la Postgres/MinIO desechables de
# docker-compose.test.yml, nunca secretos reales, y CI (.github/workflows/ci.yml)
# necesita que exista en el checkout para `node --env-file=.env.test
# scripts/migrate.mjs` — el patrón `.env*` de arriba lo bloqueaba
# silenciosamente hasta ahora (nunca se había commiteado pese al comentario
# que decía lo contrario), causa real de que integration-e2e fallara en CI.
!.env.test

# vercel
.vercel

# raw brand source files (huge originals, PDF) — web-ready derivatives live in public/ and src/app/
/brand-assets/source/

# documentos subidos en desarrollo local (lib/storage.ts) — en producción
# viven en el disco persistente de Render, nunca en el repo
/storage/

# typescript
*.tsbuildinfo
next-env.d.ts
