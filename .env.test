# Variables para tests de integración/E2E — apuntan a la Postgres
# desechable de docker-compose.test.yml, JAMÁS a producción. Sí se
# commitea (a diferencia de .env.local): no hay secretos reales acá, todo
# son credenciales de un contenedor local que vive segundos.
DATABASE_URL=postgresql://test:test@localhost:5433/skycode_test
JWT_SECRET=test-only-secret-do-not-use-in-production-e2e
ADMIN_SEED_EMAIL=admin@test.skycode.local
ADMIN_SEED_PASSWORD=TestAdminPassword123456
# Doble S3-compatible desechable (MinIO, ver docker-compose.test.yml) para
# los tests de documentos (lib/storage.ts) — nunca el bucket de R2 real de
# producción. R2_ENDPOINT le indica al cliente hablarle a MinIO en vez de
# derivar el endpoint de R2_ACCOUNT_ID (eso solo aplica a Cloudflare R2
# real, ver storage.ts); el bucket lo crea scripts/ensure-test-bucket.mjs
# automáticamente antes de correr los tests (hooks pretest:integration/
# pretest:e2e de package.json).
R2_ENDPOINT=http://localhost:9000
R2_ACCESS_KEY_ID=test-access-key
R2_SECRET_ACCESS_KEY=test-secret-key
R2_BUCKET_NAME=skycode-test-documents
# Segundo bucket, mismo MinIO, para lib/backupStorage.ts (backups de base
# de datos) — en test comparte credenciales con el bucket de documentos
# por simplicidad; en producción son un token de API y bucket
# completamente aparte (ver .env.example).
R2_BACKUPS_ENDPOINT=http://localhost:9000
R2_BACKUPS_ACCESS_KEY_ID=test-access-key
R2_BACKUPS_SECRET_ACCESS_KEY=test-secret-key
R2_BACKUPS_BUCKET_NAME=skycode-test-backups
# Tercer bucket, mismo MinIO, para lib/portfolioStorage.ts (imágenes
# públicas del portafolio) — R2_ACCOUNT_ID no aplica acá tampoco (mismo
# motivo que arriba). R2_PORTFOLIO_PUBLIC_BASE_URL no necesita servir
# contenido real: los tests solo verifican que la URL se arma bien, nunca
# le hacen un GET público a MinIO.
R2_PORTFOLIO_ENDPOINT=http://localhost:9000
R2_PORTFOLIO_ACCESS_KEY_ID=test-access-key
R2_PORTFOLIO_SECRET_ACCESS_KEY=test-secret-key
R2_PORTFOLIO_BUCKET_NAME=skycode-test-portfolio
R2_PORTFOLIO_PUBLIC_BASE_URL=http://localhost:9000/skycode-test-portfolio
# Secreto de prueba para POST /api/cron/check-notifications — solo válido
# contra la Postgres desechable de arriba, no es un secreto real.
CRON_SECRET=test-only-cron-secret-do-not-use-in-production
# Defensa de autenticación (lib/authShield.ts, lib/pow.ts): el servidor E2E
# (SKYCODE_E2E=1) acorta la edad mínima del reto de proof-of-work y el piso de
# duración del login — sin esto cada login de test esperaría ~2 s reales y la
# suite se volvería lenta. Fuera de SKYCODE_E2E esas variables se ignoran, así
# que NUNCA debilitan producción aunque se copien por error.
AUTH_POW_MIN_AGE_MS=0
AUTH_MIN_DURATION_MS=0
# Los e2e no deben depender de la red externa (Have I Been Pwned).
DISABLE_PWNED_CHECK=true
