{
  "name": "agencia-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "db:seed-dev-users": "node --env-file=.env.local scripts/seed-dev-users.mjs",
    "db:seed-articles": "node --env-file=.env.local scripts/seed-articles-from-json.mjs",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down -v",
    "test:db:migrate": "node --env-file=.env.test scripts/migrate.mjs",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "test:all": "npm run test:db:up && npm run test:db:migrate && npm run test && npm run test:integration && npm run test:e2e"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/nextjs": "^10.73.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "geoip-country": "^5.0.202608050059",
    "jose": "^6.2.8",
    "lucide-react": "^1.25.0",
    "next": "16.3.0",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.18.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/geoip-country": "^5.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "puppeteer-core": "^25.5.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "ip-address": "^10.4.0"
  },
  "browserslist": [
    "chrome >= 109",
    "edge >= 109",
    "firefox >= 109",
    "safari >= 16.4"
  ]
}
